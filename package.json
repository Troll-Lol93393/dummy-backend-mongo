{
    "name": "sheth-backend",
    "version": "1.0.0",
    "description": "Express TypeScript backend with MongoDB",
    "main": "dist/index.js",
    "scripts": {
        "start": "node --require ./dist/polyfills.js dist/index.js",
        "dev": "nodemon src/index.ts",
        "build": "npm install --include=dev && tsc",
        "build:watch": "tsc --watch",
        "clean": "rimraf dist",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\""
    },
    "keywords": [
        "express",
        "typescript",
        "mongodb",
        "backend"
    ],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.80.0",
        "@types/pdfkit": "^0.17.5",
        "adm-zip": "^0.5.16",
        "archiver": "^7.0.1",
        "axios": "^1.13.6",
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.7.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "exceljs": "^4.4.0",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "mammoth": "^1.12.0",
        "mongoose": "^8.0.3",
        "multer": "^2.0.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.4",
        "pdf-lib": "^1.17.1",
        "pdf-parse": "^2.4.5",
        "pdfkit": "^0.18.0",
        "sharp": "^0.34.5",
        "tesseract.js": "^7.0.0",
        "word-extractor": "^1.0.4",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/archiver": "^7.0.0",
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.23",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^1.4.13",
        "@types/node": "^20.19.11",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^7.0.11",
        "@types/pdf-parse": "^1.1.5",
        "@types/word-extractor": "^1.0.6",
        "nodemon": "^3.0.2",
        "prettier": "^3.6.2",
        "tsx": "^4.21.0",
        "typescript": "^5.3.3"
    }
}
